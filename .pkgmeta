package-as: GoblinToolbox

enable-nolib-creation: no

ignore:
  - README.md
  - CLAUDE.md
  - .git
  - .gitignore
  - .github
  - "*.md"
  - screenshots
  - docs
  - Initial_Project_Brief_-_Goblin_toolbox.docx
  - Current_Development_status.txt

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

license-output: LICENSE
